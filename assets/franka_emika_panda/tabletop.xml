<mujoco model="tabletop tidy">
  <include file="panda.xml"/>

  <option timestep="0.002" cone="elliptic" impratio="10"/>

  <visual>
    <headlight diffuse="0.3 0.3 0.3" ambient="0.25 0.25 0.25" specular="0 0 0"/>
    <global azimuth="150" elevation="-25" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.85 0.9 0.95" rgb2="0.6 0.65 0.7" width="512" height="3072"/>
    <texture type="2d" name="wood" builtin="flat" rgb1="0.78 0.68 0.55" width="64" height="64"/>
    <material name="table" texture="wood" specular="0.05" shininess="0.1"/>
  </asset>

  <default>
    <default class="item">
      <geom condim="4" friction="1.5 0.01 0.001" solref="0.01 1" mass="0.05"/>
    </default>
    <default class="plate">
      <geom type="cylinder" size="0.07 0.004" contype="1" conaffinity="1"/>
    </default>
  </default>

  <worldbody>
    <light pos="0.5 0 1.5" dir="0 0 -1" directional="true" diffuse="0.45 0.45 0.45"/>
    <geom name="table" type="plane" size="1 1 0.05" material="table"/>

    <!-- 真上カメラ：Claude に渡す画像。画素→机上の座標の変換に使う -->
    <camera name="overhead" pos="0.5 0 1.1" xyaxes="0 -1 0 1 0 0" fovy="45"/>
    <!-- 動画用の斜めカメラ -->
    <camera name="front" pos="1.35 0.0 0.75" xyaxes="0 1 0 -0.45 0 0.89" fovy="50"/>

    <!-- 置き場所（皿）。位置は reset 時に動かす -->
    <body name="plate_blue" mocap="true" pos="0.5 0.3 0.004">
      <geom class="plate" rgba="0.2 0.4 0.9 1"/>
    </body>
    <body name="plate_yellow" mocap="true" pos="0.5 -0.3 0.004">
      <geom class="plate" rgba="0.95 0.8 0.2 1"/>
    </body>

    <!-- つかむ物 -->
    <body name="red_box" pos="0.45 0.0 0.025">
      <freejoint/>
      <geom class="item" type="box" size="0.022 0.022 0.022" rgba="0.9 0.15 0.15 1"/>
    </body>
    <body name="green_cylinder" pos="0.6 0.1 0.03">
      <freejoint/>
      <geom class="item" type="cylinder" size="0.02 0.03" rgba="0.2 0.75 0.3 1"/>
    </body>
    <body name="purple_box" pos="0.6 -0.1 0.025">
      <freejoint/>
      <geom class="item" type="box" size="0.022 0.022 0.022" rgba="0.6 0.3 0.8 1"/>
    </body>
  </worldbody>
</mujoco>
